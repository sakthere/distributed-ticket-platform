{
  "ConnectionStrings": { "DefaultConnection": "Server=SAKET;Database=TMS;Trusted_Connection=True;TrustServerCertificate=True;" },
  "JwtSettings": {
    "SecretKey": "THIS_IS_A_SUPER_SECRET_KEY_AT_LEAST_32_CHARACTERS",
    "Issuer": "TicketManagementApi",
    "Audience": "TicketManagementClient",
    "ExpiryMinutes": 60
  },
  "RefreshTokenSettings": {
      "ExpiryDays":  7
   },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "*"
}